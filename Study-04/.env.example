# FridgeChef settings. Copy this file to .env and fill in your key:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored: never commit it, paste it in chat, or put a key in public/.

# --- Anthropic (Claude): used when ANTHROPIC_API_KEY is set ---
# Your key from the Claude Console, https://platform.claude.com (starts with sk-ant-).
ANTHROPIC_API_KEY=sk-ant-your-key-here
# One model reads the fridge photo and writes the recipe.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if Anthropic says the key "is not scoped to a workspace": the workspace ID
# from Claude Console → Settings → Workspaces (it isn't secret, but it's yours).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- OpenRouter: optional backup (used when there's no Anthropic key, or with AI_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free

# Optional: force a provider (anthropic or openrouter).
# AI_PROVIDER=anthropic

# Optional: where the local server listens. HOST must stay a local address.
# HOST=127.0.0.1
# PORT=8790
