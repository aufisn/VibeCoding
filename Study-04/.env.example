# FridgeChef settings. Copy this file to .env and fill in your key:
#   cp .env.example .env && chmod 600 .env
# .env is git-ignored: never commit it, paste it in chat, or put the key in public/.

# Your OpenRouter key, from https://openrouter.ai/keys (starts with sk-or-).
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model that recognises the ingredients in the fridge photo (must accept images).
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Model that writes the recipe.
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free

# Optional: where the local server listens. HOST must stay a local address.
# HOST=127.0.0.1
# PORT=8790
