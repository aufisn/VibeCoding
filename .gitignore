# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# Study-01 EMNIST training data (193 MB; one file is over GitHub's 100 MB limit).
# Download it locally to retrain; see Study-01/CLAUDE.md.
Study-01/data/

# Local Claude Code settings (preview server config etc.)
.claude/

# ...except project skills, which belong in the repo.
!Study-03/.claude/
Study-03/.claude/*
!Study-03/.claude/skills/
!Study-03/.claude/commands/
!Study-04/.claude/
Study-04/.claude/*
!Study-04/.claude/agents/
!Study-05/.claude/
Study-05/.claude/*
!Study-05/.claude/agents/

# Local question-bank backups made by scripts/backup-questions.mjs (git history keeps every version too).
Study-03/backups/

# Teacher mode: players' real backup files stay on the teacher's computer.
Study-03/class/

# Secrets (API keys) never go to GitHub.
.env
.env.*
!.env.example

# Node packages (reinstall with npm install).
node_modules/

# FridgeChef: the secret Gist ID stays on this Mac.
Study-04/.fc_gist_id
