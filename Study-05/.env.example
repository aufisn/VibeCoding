# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Your Anthropic API key (Claude Console -> API keys).
ANTHROPIC_API_KEY=
# Only needed if your key is not tied to a workspace (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# The journal (an encrypted copy of your entries in your secret GitHub Gist). Without these three
# the diary still answers, but nothing is saved (the page says so and offers "Try saving again").
# The Gist ID: the 32 letters and numbers at the end of the Gist's web address.
FC_GIST_ID=
# A classic GitHub token with only the "gist" scope.
FC_GIST_TOKEN=
# Your passphrase (at least 12 characters). The same one as on your phone. Lose it and the journal can't be read.
FC_PASSPHRASE=
